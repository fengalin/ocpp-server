[Unit]
Description=OCPP server daemon

[Service]
User=ocpp
Group=ocpp
Type=simple
ExecStart=/home/ocpp/.local/bin/ocpp-server run
WorkingDirectory=/home/ocpp/
RuntimeDirectory=charge_point
RuntimeDirectoryPreserve=true
UMask=002
StandardOutput=append:/home/ocpp/server_out.log
StandardError=append:/home/ocpp/server_err.log
KillSignal=SIGINT
Restart=on-failure
RestartSec=10
NoNewPrivileges=true

[Install]
WantedBy=default.target
